{
  "name": "apple-hig-mcp",
  "version": "0.2.0",
  "description": "Unofficial MCP server for searching and reading Apple's Human Interface Guidelines",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "apple-hig-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fuse.js": "^7.5.0",
    "p-queue": "^9.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

{
  "name": "hig-mcp",
  "version": "1.0.0",
  "description": "Apple Human Interface Guidelines MCP Server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test-parser": "ts-node src/parser/testParser.ts",
    "dev": "ts-node src/server.ts",
    "start": "node dist/server.js",
    "test:mcp": "node scripts/test-mcp.js",
    "start:mcp": "node dist/index.js",
    "dev:mcp": "tsx src/index.ts",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "index": "tsx scripts/index-content.ts",
    "index:incremental": "tsx scripts/index-content.ts --incremental",
    "index:test": "tsx scripts/index-content.ts --test",
    "index:rebuild": "tsx scripts/index-content.ts --rebuild-index",
    "create-labels": "node scripts/create-github-labels.js",
    "create-issues": "node scripts/create-github-issues.js",
    "create-issues:dry": "node scripts/create-github-issues.js --dry-run",
    "create-issues:api": "node scripts/create-github-issues-api.js",
    "create-issues:api:dry": "node scripts/create-github-issues-api.js --dry-run",
    "create-issues:shell": "bash scripts/create-github-issues.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "chalk": "^5.3.0",
    "cheerio": "^1.1.0",
    "fuse.js": "^7.1.0",
    "jsdom": "^24.0.0",
    "node-cache": "^5.1.2",
    "ora": "^8.0.1",
    "p-queue": "^8.1.0",
    "playwright": "^1.52.0",
    "zod": "^3.25.57"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}

{
  "name": "hig-review",
  "version": "0.3.0",
  "description": "Review Apple-platform UI against Apple's Human Interface Guidelines: cited checklists, SwiftUI heuristics and contrast checks (MCP server and Claude Code plugin)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hig-review": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "clean": "rm -rf dist",
    "smoke:bundle": "npm run build && node scripts/smoke.mjs --bundle",
    "docs:rules": "npm run build && node scripts/rules-doc.mjs"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fuse.js": "^7.5.0",
    "p-queue": "^9.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
